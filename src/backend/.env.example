# ── Official Evidence (Mode2.CTD) ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=Mode2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PIPELINE_VERSION=mode2-official-evidence-v1
# Only enable for isolated tests. Production ingestion must use SentenceTransformers.
ALLOW_DETERMINISTIC_EMBEDDINGS=false

# ── User Evidence (Mode2v2.UserCTD) ───────────────────────────────────────────
# Defaults to MONGODB_URI if not set — set explicitly when using a separate cluster.
USER_MONGODB_URI=
USER_MONGODB_DATABASE=Mode2v2
USER_PIPELINE_VERSION=mode2-user-evidence-v2

# ── Hugging Face ───────────────────────────────────────────────────────────────
# Prevents rate-limiting warnings when downloading embedding models.
# Generate a read-only token at https://huggingface.co/settings/tokens
HF_TOKEN=
